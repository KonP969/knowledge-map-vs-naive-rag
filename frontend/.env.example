# The frontend talks to the backend through Vite's dev proxy (see vite.config.ts),
# so nothing here is needed for local development.
#
# Set VITE_API_BASE only when the built frontend is served separately from the API,
# e.g. VITE_API_BASE=https://api.example.com/api
# VITE_API_BASE=
#
# Set VITE_PROXY_TARGET if the backend runs somewhere other than http://localhost:8000
# VITE_PROXY_TARGET=http://localhost:8001
