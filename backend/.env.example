# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: OpenAI API key (used for both chat completions and embeddings)
OPENAI_API_KEY=sk-...

# Optional: override the default models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: which knowledge base to load (default: wiki_data/default, which starts empty).
# Set to wiki_data/.example to explore the bundled demo corpus.
# WIKI_DATA_DIR=wiki_data/.example
